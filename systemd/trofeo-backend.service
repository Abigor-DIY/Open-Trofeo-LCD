[Unit]
Description=Open Trofeo LCD Backend API
After=default.target

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
EnvironmentFile=__WORKDIR__/.trofeo-backend.env
ExecStart=/bin/bash __WORKDIR__/scripts/run_backend_service.sh
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
