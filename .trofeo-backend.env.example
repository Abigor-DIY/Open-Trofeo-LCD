HOST=127.0.0.1
PORT=18777

# Relative to repo root or absolute path.
PCAP_FILE=dzis.pcapng
FRAME_INDEX=0

ACK_TIMEOUT_MS=500
INTER_PACKET_DELAY=0.01
FRAME_DELAY=0.02
CONNECT_RETRIES=20
CONNECT_RETRY_DELAY=0.5

# Relative to repo root or absolute path.
THEMES_FILE=.trofeo-themes.json
PLAYLIST_FILE=.trofeo-playlist.json

# Legacy PCAP replay autostart. Keep disabled for normal GUI/theme usage.
AUTOSTART=0

# Optional theme loaded by the backend service before the GUI starts.
STARTUP_THEME=

# Optional weather widget data. Leave LAT/LON empty to disable network weather.
# Open-Meteo is used by default and does not require an API key.
OPEN_TROFEO_WEATHER_LAT=
OPEN_TROFEO_WEATHER_LON=
OPEN_TROFEO_WEATHER_LOCATION=
OPEN_TROFEO_WEATHER_REFRESH_S=900
OPEN_TROFEO_WEATHER_TEMP_UNIT=celsius

# Animation smoothness / USB bandwidth tuning.
# Target animation refresh rate on the LCD (5-60). The 1920x462 panel measured
# ~24 FPS steady with the default JPEG quality below. Raise carefully; too high
# a value speeds up authored animations and starts dropping frames.
OPEN_TROFEO_ANIMATION_FPS=24
# JPEG quality for animated frames (5-100). Lower = smaller frames = faster USB
# transfer. 80 measured ~117 KB/frame (vs ~300 KB at 95) and roughly doubled the
# achievable FPS; 60 gave no further speedup, so 80 is the sweet spot.
OPEN_TROFEO_JPEG_QUALITY=80
# Hard upper bound for each encoded JPEG frame in bytes (0 = TRCC default).
OPEN_TROFEO_JPEG_MAX_BYTES=350000
