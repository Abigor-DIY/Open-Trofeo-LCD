HOST=127.0.0.1
PORT=18777

# Relative to repo root or absolute path.
PCAP_FILE=dzis.pcapng
FRAME_INDEX=0

ACK_TIMEOUT_MS=500
INTER_PACKET_DELAY=0.01
FRAME_DELAY=0.02
CONNECT_RETRIES=20
CONNECT_RETRY_DELAY=0.5

# Relative to repo root or absolute path.
THEMES_FILE=.trofeo-themes.json
PLAYLIST_FILE=.trofeo-playlist.json

# Legacy PCAP replay autostart. Keep disabled for normal GUI/theme usage.
AUTOSTART=0

# Optional theme loaded by the backend service before the GUI starts.
STARTUP_THEME=

# Optional weather widget data. Leave LAT/LON empty to disable network weather.
# Open-Meteo is used by default and does not require an API key.
OPEN_TROFEO_WEATHER_LAT=
OPEN_TROFEO_WEATHER_LON=
OPEN_TROFEO_WEATHER_LOCATION=
OPEN_TROFEO_WEATHER_REFRESH_S=900
